import os
import re

def test_css_file_exists():
    """Тест 1: Проверка наличия файла стилей"""
    print("\n[Тест 1] Проверка наличия файла style.min.css...")
    
    css_path = "style.min.css"
    if os.path.exists(css_path):
        print(f"✅ Файл {css_path} найден")
        return True
    else:
        print(f"❌ Файл {css_path} не найден")
        return False

def test_css_minification():
    """Тест 2: Проверка минификации CSS"""
    print("\n[Тест 2] Проверка минификации CSS...")
    
    try:
        with open("style.min.css", "r", encoding="utf-8") as f:
            content = f.read()
        
        line_count = content.count('\n')
        
        if line_count < 10:
            print(f"✅ CSS минифицирован корректно (строк: {line_count})")
            return True
        else:
            print(f"⚠️ CSS возможно не минифицирован (строк: {line_count})")
            return False
    except FileNotFoundError:
        print("❌ Файл style.min.css не найден")
        return False

def test_html_viewport():
    """Тест 3: Проверка наличия meta-тега viewport"""
    print("\n[Тест 3] Проверка наличия viewport в index.html...")
    
    try:
        with open("index.html", "r", encoding="utf-8") as f:
            content = f.read()
        
        if 'viewport' in content and 'width=device-width' in content:
            print("✅ Мета-тег viewport найден")
            return True
        else:
            print("❌ Мета-тег viewport не найден")
            return False
    except FileNotFoundError:
        print("❌ Файл index.html не найден")
        return False

def test_html_css_link():
    """Тест 4: Проверка подключения минифицированного CSS"""
    print("\n[Тест 4] Проверка подключения style.min.css...")
    
    try:
        with open("index.html", "r", encoding="utf-8") as f:
            content = f.read()
        
        if 'style.min.css' in content:
            print("✅ Файл style.min.css подключен корректно")
            return True
        else:
            print("❌ style.min.css не найден в index.html")
            return False
    except FileNotFoundError:
        print("❌ Файл index.html не найден")
        return False

def test_media_queries():
    """Тест 5: Проверка наличия медиа-запросов"""
    print("\n[Тест 5] Проверка наличия медиа-запросов...")
    
    try:
        with open("style.min.css", "r", encoding="utf-8") as f:
            content = f.read()
        
        media_found = re.findall(r'@media\s*\([^)]+\)', content)
        
        if media_found:
            print(f"✅ Найдены медиа-запросы: {len(media_found)} шт.")
            return True
        else:
            print("❌ Медиа-запросы не найдены")
            return False
    except FileNotFoundError:
        print("❌ Файл style.min.css не найден")
        return False

def run_all_tests():
    """Запуск всех тестов"""
    print("=" * 50)
    print("ЗАПУСК ТЕСТОВ ДЛЯ ПРОВЕРКИ АДАПТИВНОЙ ВЁРСТКИ")
    print("=" * 50)
    
    results = []
    results.append(test_css_file_exists())
    results.append(test_css_minification())
    results.append(test_html_viewport())
    results.append(test_html_css_link())
    results.append(test_media_queries())
    
    print("\n" + "=" * 50)
    print("РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ")
    print("=" * 50)
    
    passed = sum(results)
    total = len(results)
    
    print(f"Пройдено тестов: {passed} из {total}")
    
    if passed == total:
        print("\n🎉 ВСЕ ТЕСТЫ УСПЕШНО ПРОЙДЕНЫ!")
        print("Адаптивная вёрстка и оптимизация выполнены корректно.")
    else:
        print(f"\n⚠️ Не пройдено тестов: {total - passed}. Требуется доработка.")
    
    return passed == total

if __name__ == "__main__":
    run_all_tests()